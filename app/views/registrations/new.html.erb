<div class="auth-container">
  <h2>Sign up</h2>

  <%= tag.div(flash[:alert], class: "flash-alert") if flash[:alert] %>
  <%= tag.div(flash[:notice], class: "flash-notice") if flash[:notice] %>

  <% if @user && @user.errors.any? %>
    <div class="error-explanation">
      <p>Please fix the following errors:</p>
      <ul>
        <% @user.errors.full_messages.each do |mess| %>
          <li><%= mess %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <div>
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address" %>
    </div>

    <div>
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter your password", maxlength: 72 %>
    </div>

    <div>
      <%= form.submit "Sign up" %>
    </div>
  <% end %>

  <div class="auth-links-center">
    <%= link_to "Back to login", new_session_path %>
  </div>
</div>