<% if authenticated? && controller_name != 'sessions' && controller_name != 'registrations' && controller_name != 'passwords' %>
    <nav class="app-navbar">
        <div class="navbar-container">
            <div class="navbar-links">
                <%= link_to "Home", devices_path, class: "navbar-brand" %>
                <%= link_to "Profile", profile_path, class: "navbar-link" %>
            </div>
            <div class="navbar-actions">
                <%= button_to "Logout", session_path, method: :delete, class: "btn-logout" %>
            </div>
        </div>
    </nav>
<% end %>