<% content_for :title, "Measurement details" %>

<div class="dashboard-container">
  <div class="content-header">
    <% if notice.present? %>
      <p class="flash-notice"><%= notice %></p>
    <% end %>
    <div class="back-link-container">
      <%= link_to "← Return", device_measurements_path(@device), class: "btn-back" %>
    </div>
 
    <div class="dashboard-header">
      <h1 class="dashboard-title">Measurement Details</h1>
    </div>
  </div>

  <div class="device-details-card">
    
    <%= render @measurement %>
    
    <div class="device-show-actions">
      <%= link_to "Edit", edit_device_measurement_path(@device, @measurement), class: "btn-primary" %>
      <%= button_to "Destroy", [@device, @measurement], method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn-danger" %>
    </div>

  </div>
</div>