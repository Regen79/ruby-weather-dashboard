<h1>Measurements for <%= @device.name %></h1>
<%= link_to "Back to device", device_path(@device) %>
<table>
  <thead>
    <tr>
      <th>Date & Time</th>
      <th>Temperature</th>
      <th>Humidity</th>
    </tr>
  </thead>
  <tbody>
    <% @measurements.each do |measurement| %>
      <tr>
        <td><%= link_to measurement.created_at.strftime("%Y-%m-%d %H:%M:%S"), device_measurement_path(@device, measurement), class: "row-link" %></td>
        <td><%= link_to measurement.temperature, device_measurement_path(@device, measurement), class: "row-link" %></td>
        <td><%= link_to measurement.humidity, device_measurement_path(@device, measurement), class: "row-link" %></td>
      </tr>
    <% end %>
  </tbody>
</table> 