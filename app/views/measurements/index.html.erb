<h1>Measurements for <%= @device.name %></h1>
<table>
  <thead>
    <tr>
      <th>Date & Time</th>
      <th>Temperature</th>
      <th>Humidity</th>
    </tr>
  </thead>
  <tbody>
    <% @measurements.each do |measurement| %>
      <tr>
        <td><%= measurement.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= measurement.temperature %>°C</td>
        <td><%= measurement.humidity %>%</td>
      </tr>
    <% end %>
  </tbody>
</table> 