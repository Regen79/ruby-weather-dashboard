<% content_for :title, "Measurements for #{@device.name}" %>

<div class="dashboard-container">
  <div class="back-link-container">
    <%= link_to "← Return", devices_path, class: "btn-back" %>
  </div>

  <div class="dashboard-header">
    <h1 class="dashboard-title">Measurements for <%= @device.name %></h1>
  </div>

  <div class="last-measurements-container">
    <div class="last-measurements-card">
      <h2 class="last-measurements-title">Actual Temperature: </h2>
      <div class="last-measurements-number temperature"> 
        <%= @lastest_temperature  || "--" %>°C
      </div>
    </div>

    <div class="last-measurements-card">
      <h2 class="last-measurements-title">Actual Humidity: </h2>
      <div class="last-measurements-number humidity"> 
        <%= @lastest_humidity  || "--" %>%
      </div>
    </div>
  </div>

  <div class="measurement-card">
    <div class="table-container">
      <table class="measurements-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Temperature</th>
            <th>Humidity</th>
          </tr>
        </thead>
        <tbody>
          <% @measurements.order(created_at: :desc).each do |measurement| %>
            <tr>
              <td><%= measurement.created_at.strftime("%Y-%m-%d")%></td>
              <td><%= measurement.created_at.strftime("%H:%M:%S")%></td>
              <td><%= measurement.temperature%></td>
              <td><%= measurement.humidity%></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="day-filters">
    <% (Date.current.beginning_of_week(:monday)..Date.current.end_of_week(:monday)).each do |day| %>
      <% is_active = (params[:day].present? ? params[:day] == day.to_s : day == Date.current) %>
      <%= link_to day.strftime("%A"), 
                  device_measurements_path(@device, day: day), 
                  class: "day-btn #{is_active ? 'active' : ''}" %>  
    <% end %>
  </div>

  <div class="charts-grid">
    <div class="chart-card">
      <h4 class="chart-title">Temperature</h4>
      <%= line_chart @filtered_measurements.map { |m| [m.created_at.strftime("%H:%M"), m.temperature] }, area: true, suffix: " °C", colors: ["#f59e0b"] %>
    </div>

    <div class="chart-card">
      <h4 class="chart-title">Humidity</h4>
      <%= line_chart @filtered_measurements.map { |m| [m.created_at.strftime("%H:%M"), m.humidity] }, suffix: " %", colors: ["#3b82f6"] %>
    </div>

    <div class="chart-card">
      <h4 class="chart-title">Average Monthly Temperature</h4>
      <%= line_chart @monthly_temperatures, suffix: " °C", colors: ["#f59e0b"] %>
    </div>

    <div class="chart-card">
      <h4 class="chart-title">Average Monthly Humidity</h4>
      <%= line_chart @monthly_humidities, suffix: " %", colors: ["#3b82f6"] %>
    </div>
  </div>
</div>