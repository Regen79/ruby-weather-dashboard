<% content_for :title, "Devices" %>

<div class="dashboard-container">
  <% if notice.present? %>
    <p class="flash-notice"><%= notice %></p>
  <% end %>

  <div class="dashboard-header">
    <h1 class="dashboard-title">Devices</h1>
    <%= link_to "New device", new_device_path, class: "btn-primary" %>
  </div>

  <div class="devices-grid" id="devices">
    <% @devices.each do |device| %>
      <div class="device-card">
        <%= link_to device_measurements_path(device), class: "device-card-content" do %>
          <div class="device-card-name">
            <span class="device-value"><%= device.name %></span>
          </div>
        <% end %>
      
        <div class="device-actions">
          <%= link_to "Show", device_path(device), class: "btn-secondary" %>
          <%= button_to "Delete", device, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
</div>