<p style="color: green"><%= notice %></p>

<%= render @device %>

<div>
  <strong>API token for this device:</strong><br>
  <code><%= @device.api_key %></code>
</div>

<div>
  <p>
    <%= link_to "View measurements", device_measurements_path(@device) %>
  </p>
  <%= link_to "Edit this device", edit_device_path(@device) %> |
  <%= link_to "Back to devices", devices_path %>

  <%= button_to "Destroy this device", @device, method: :delete %>
</div>
