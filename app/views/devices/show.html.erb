<div class="dashboard-container">
  <div class="content-header">
    <% if notice.present? %>
      <p class="flash-notice"><%= notice %></p>
    <% end %>
    <div class="back-link-container">
      <%= link_to "← Return", devices_path, class: "btn-back" %>
    </div>

    <div class="dashboard-header">
      <h1 class="dashboard-title">Device details</h1>
    </div>
  </div>

  <div class="device-details-card">
    <div class="device-info">
      <%= render @device %>
    </div>

    <% if flash[:api_key].present? %>
      <div class="api-key-box">
        <strong>API token for this device:</strong><br>
        <code><%= @device.api_key %></code>
      </div>
    <% end %>

    <div class="device-show-actions">
      <%= link_to "View measurements", device_measurements_path(@device), class: "btn-primary" %>
      <%= link_to "Edit this device", edit_device_path(@device), class: "btn-secondary" %>
      <%= button_to "Destroy this device", @device, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn-danger" %>
    </div>
  </div>
</div>  