#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  echo "== Preparing databases and running migrations =="
  ./bin/rails db:prepare
  ./bin/rails db:migrate:cache || true
  ./bin/rails db:migrate:queue || true
  ./bin/rails db:migrate:cable || true
fi

exec "${@}"
